#!/usr/bin/env bash
# CoolCallPro pre-commit hook — enforces YMYL / SEO / AEO / GEO / CSS regression
# checks on every staged HTML file. Blocks the commit on failure.
#
# Installed at: .git/hooks/pre-commit (via scripts/install-hooks.sh)
# Source of truth (version-controlled): scripts/pre-commit
#
# Behavior:
#   articles/*.html   -> python audit_article.py <file> --ci
#                        (full strict mode: YMYL, GEO/AEO, HowTo, speakable,
#                         CSS regression, cost drift vs costs.html, FAQ pattern)
#   any other *.html  -> python audit_page.py <file>
#                        (universal: GA defer, no Google Fonts CDN, footer-col
#                         structure, MarketCall disclaimer lock, h1/meta/canonical)
#
# Layer 2 _redirects sync: when any HTML file is Added/Deleted/Renamed in this
# commit, scripts/regenerate_redirects.py runs after the audits and the updated
# _redirects file is auto-staged into the same commit. Layer 1 (build.sh) is the
# deploy-time backstop — even bypassed commits ship a fresh _redirects because
# build.sh regenerates it before every Cloudflare Pages deploy.
#
# Browser verification (underline rendering, FAQ expand, hero render) remains
# agent discipline — the hook enforces every text-inspectable check.
#
# Bypass (do NOT use without a reason): git commit --no-verify

set -u

# Collect staged HTML changes:
#  - staged_html (ACMR): files whose content needs auditing
#  - html_adr (ADR):     events that require _redirects regen (Layer 2)
# Skip everything only if neither set has entries.
mapfile -t staged_html < <(git diff --cached --name-only --diff-filter=ACMR -- '*.html')
mapfile -t html_adr   < <(git diff --cached --name-only --diff-filter=ADR  -- '*.html')

if [ "${#staged_html[@]}" -eq 0 ] && [ "${#html_adr[@]}" -eq 0 ]; then
    exit 0
fi

fail_count=0
article_count=0
page_count=0

echo "== CoolCallPro pre-commit audit =="
echo "Staged HTML files: ${#staged_html[@]}"
echo

for file in "${staged_html[@]}"; do
    # Skip files that were deleted (diff-filter should prevent this, but be safe)
    if [ ! -f "$file" ]; then
        continue
    fi

    case "$file" in
        articles/*.html)
            article_count=$((article_count + 1))
            echo "-- audit_article.py --ci $file"
            if ! python audit_article.py "$file" --ci; then
                fail_count=$((fail_count + 1))
                echo
                echo "   ^^ FAILED: $file"
                echo
            fi
            ;;
        *.html)
            page_count=$((page_count + 1))
            echo "-- audit_page.py $file"
            if ! python audit_page.py "$file"; then
                fail_count=$((fail_count + 1))
                echo
                echo "   ^^ FAILED: $file"
                echo
            fi
            ;;
    esac
done

echo
echo "== Summary: $article_count article(s), $page_count page(s), $fail_count failure(s) =="

if [ "$fail_count" -gt 0 ]; then
    echo
    echo "COMMIT BLOCKED. Fix the failures above and re-stage."
    echo "Bypass (not recommended): git commit --no-verify"
    exit 1
fi

# Layer 2: keep _redirects in sync with the actual HTML set.
# Triggers when HTML files are Added/Deleted/Renamed (M-modify doesn't change
# the redirect entry — the URL stays the same). Regen is idempotent so re-runs
# are safe. The regenerated _redirects is auto-staged into the same commit so
# git history shows the URL change and the redirect entry as one atomic unit.
# html_adr was computed at the top of this hook alongside the audit set.
if [ "${#html_adr[@]}" -gt 0 ]; then
    echo
    echo "== Layer 2 sync: ${#html_adr[@]} HTML add/delete/rename detected, regenerating _redirects =="
    if ! python scripts/regenerate_redirects.py; then
        echo
        echo "ERROR: scripts/regenerate_redirects.py failed."
        echo "COMMIT BLOCKED. Investigate and fix, then re-stage."
        exit 1
    fi
    git add _redirects
    echo "  _redirects regenerated and auto-staged into this commit."
fi

exit 0

# Local audit working files (PSI JSON, QC exports — regenerated on every audit run)
_audit/

# Deploy snapshots (one-off frozen copies — not source)
deploy */
deploy\ */

# Cloudflare Pages build output (regenerated by build.sh on every deploy)
_dist/

# Search Console analytics exports (not source)
Search\ Console_*/
"Search Console_"*/

# Cloudflare CLI cache
.wrangler/

# Local Claude config
.claude/

# One-off docx audits / screenshots in root
*.docx
/alabama-*.png
/alabama-*.webp
/locations-review.png
/locations-review.webp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# Node (in case anything installs node_modules)
node_modules/
package-lock.json

# Logs
*.log

# Auto-generated audit report (regenerates on every `python audit_site.py` run)
SITE_AUDIT.md

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*~

# Excel lock files (created when xlsx is open)
~$*.xlsx
~$*.xls

# Secrets / credentials — defense-in-depth.
# None exist today and the audit on 24 Apr 2026 confirmed git history is clean.
# These patterns prevent a future accidental commit if a tool ever auto-creates
# one (.env from npm packages, .pem from openssl, etc.).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
secrets.json
secrets.yaml
secrets.toml
*.crt
.cloudflare-token

# Local-only image fetch artifacts (logs and audit preview)
images/_fetch_log.txt
images/_states_fetch_log.txt
images/_preview.html
images/_failed.txt

.playwright-mcp/

# Brainstorming visual-companion mockups (local-only)
.superpowers/
